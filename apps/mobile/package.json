  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:apk": "export JAVA_HOME=\"$HOME/jdk/jdk-17.0.11+9/Contents/Home\" && export ANDROID_HOME=\"$HOME/Library/Android/sdk\" && export PATH=\"$JAVA_HOME/bin:$ANDROID_HOME/platform-tools:$PATH\" && (cp -f ../../.env .env 2>/dev/null || true) && cd android && ./gradlew :app:assembleDebug",
    "build:apk:release": "export JAVA_HOME=\"$HOME/jdk/jdk-17.0.11+9/Contents/Home\" && export ANDROID_HOME=\"$HOME/Library/Android/sdk\" && export PATH=\"$JAVA_HOME/bin:$ANDROID_HOME/platform-tools:$PATH\" && (cp -f ../../.env .env 2>/dev/null || true) && cd android && ./gradlew :app:assembleRelease"
  },
