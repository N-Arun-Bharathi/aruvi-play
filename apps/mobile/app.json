{
  "expo": {
    "name": "Aruvi Play",
    "slug": "aruvi-play",
    "version": "1.4.3",
    "orientation": "portrait",
    "icon": "./assets/aruvi-play.png",
    "scheme": "aruviplay",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/aruvi-play.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aruvi.play",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.aruvi.play",
      "versionCode": 17,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "INTERNET",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_AUDIO",
        "POST_NOTIFICATIONS",
        "READ_PHONE_STATE",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}